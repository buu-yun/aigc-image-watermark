# 统一换行：代码用 LF，Windows 脚本用 CRLF，避免 clone 后整文件"被改动"
* text=auto

*.c     text eol=lf
*.h     text eol=lf
*.md    text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf

*.bat   text eol=crlf
*.ps1   text eol=crlf

*.bmp   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.exe   binary
